PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# AI (Groq). Leave GROQ_API_KEY empty to run in manual mode (no AI, app still works).
GROQ_API_KEY=
GROQ_TRIAGE_MODEL=llama-3.1-8b-instant
GROQ_DRAFT_MODEL=llama-3.3-70b-versatile

# Optional: pin "today" (YYYY-MM-DD) for demos/tests of payout-date logic
REFERENCE_DATE=
